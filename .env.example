# Placeholders only. Applications read process environment, never dotenv files.
# Compose can load this file after you copy it to .env and set local values.
APP_ENV=development
API_BIND=127.0.0.1
API_PORT=8000
WEB_PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
MODEL_API_BASE_URL=https://api.meta.ai/v1
MODEL_API_KEY=
OWNER_AUTH_TOKEN=
OWNER_LABEL=local-owner
WEB_ORIGIN=http://localhost:3000
# Next server only; use the API loopback address for host development.
API_INTERNAL_URL=http://127.0.0.1:8000
# Compose requires both POSTGRES_PASSWORD and OWNER_AUTH_TOKEN to be non-empty.
POSTGRES_PASSWORD=
# Host execution: export these explicitly, or use a fully expanded DATABASE_URL.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=counterforge
PGUSER=counterforge
PGPASSWORD=
REDIS_URL=redis://127.0.0.1:6379/0
RUN_META_LIVE_TESTS=0
MAX_CONCURRENT_PROVIDER_CALLS=1
DEFAULT_MAX_CANDIDATES=20
DEFAULT_MAX_TARGET_CALLS=60
DEFAULT_MAX_ESTIMATED_USD=10.0
DEFAULT_MAX_RUNTIME_SECONDS=1200
ARTIFACT_ROOT=./artifacts
PUBLIC_DEMO_MODE=read_only
# Phase 03 defaults fail closed. FIXTURE requires development/test and explicit opt-in.
PROVIDER_MODE=DISABLED
ALLOW_SYNTHETIC_FIXTURES=0
PRICING_PATH=./pricing.toml
ENQUEUE_JOBS=0
QUEUE_NAME=counterforge
MAX_PENDING_JOBS=100
# Live smoke also requires an EXISTING operator deployment allowance and owned refs.
# SMOKE_META_MAX_USD=
# SMOKE_META_MAX_CALLS=
# SMOKE_META_MAX_RUNTIME_SECONDS=
# SMOKE_META_SEED_ID=
# SMOKE_META_VTC_ID=
# SMOKE_META_TARGET_ID=
