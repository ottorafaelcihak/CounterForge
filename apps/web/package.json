{
  "name": "counterforge-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "generate-types": "openapi-typescript ../../packages/contracts/schemas/openapi.json -o lib/types/api.generated.ts",
    "test": "node --test --test-isolation=none tests/*.test.mjs"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "openapi-typescript": "7.13.0",
    "eslint-config-next": "16.4.3",
    "eslint": "9.39.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  }
}
